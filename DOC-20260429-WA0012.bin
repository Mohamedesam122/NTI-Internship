   "cell_type": "code",
   "source": [
    "X=data.drop([\"passed\",\"final_score\"],axis=1)\n",
    "y=data[\"passed\"]\n",
    "y_encodes=np.where(y==\"Yes\",1,0)\n",
    "X=X.select_dtypes(include=[np.number])"
   ],
